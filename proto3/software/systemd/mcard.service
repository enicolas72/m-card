[Unit]
Description=M-Card - RFID card player for Roon albums
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcard
Group=mcard
SupplementaryGroups=i2c gpio plugdev
# lgpio writes its notification file (.lgd-nfy-*) into the cwd
WorkingDirectory=/var/lib/mcard
ExecStart=/opt/mcard/venv/bin/python -m mcard --config /etc/mcard
Restart=always
RestartSec=5
# the ACR122U reader can take a while to enumerate at boot
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
